{
  "name": "littlepad",
  "version": "0.1.0",
  "description": "Soundpad ขนาดเล็กสำหรับเล่นเสียงเข้าไมค์ใน Discord",
  "main": "dist/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node18 --format=cjs --external:electron --outfile=dist/main/index.js",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node18 --format=cjs --external:electron --outfile=dist/preload/index.js",
    "build:renderer": "esbuild src/renderer/index.ts --bundle --format=iife --target=chrome120 --outfile=dist/renderer/index.js",
    "build:static": "node scripts/copy-static.mjs",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer && npm run build:static",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.3"
  },
  "build": {
    "appId": "dev.local.Littlepad",
    "productName": "Littlepad",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Littlepad-${version}.exe"
    }
  }
}